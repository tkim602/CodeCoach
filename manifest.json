{
  "manifest_version": 3,
  "name": "CodeCoach",
  "description": "Progressive AI hints and local weakness tracking for LeetCode and Programmers practice pages.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "identity",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "oauth2": {
    "client_id": "714177801459-elt7l8cl35rbglvgl51loueu98ob6jms.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "openid"
    ]
  },
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "https://www.leetcode.com/problems/*",
    "https://school.programmers.co.kr/learn/courses/*",
    "https://programmers.co.kr/learn/courses/*",
    "https://www.programmers.co.kr/learn/courses/*",
    "https://api.openai.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Open CodeCoach",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png"
    }
  },
  "options_page": "src/options/index.html",
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://www.leetcode.com/problems/*",
        "https://school.programmers.co.kr/learn/courses/*/lessons/*",
        "https://programmers.co.kr/learn/courses/*/lessons/*",
        "https://www.programmers.co.kr/learn/courses/*/lessons/*"
      ],
      "js": [
        "src/content/monaco-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://www.leetcode.com/problems/*",
        "https://school.programmers.co.kr/learn/courses/*/lessons/*",
        "https://programmers.co.kr/learn/courses/*/lessons/*",
        "https://www.programmers.co.kr/learn/courses/*/lessons/*"
      ],
      "js": [
        "src/content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
